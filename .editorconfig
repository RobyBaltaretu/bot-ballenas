# CP-M24 (auditoría 26/11/2026): una sola codificación. tests/test_codificacion.py lo comprueba en los .py.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,sh,md,json,jsonl,js,css,html,service,timer,path}]
end_of_line = lf

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# En Markdown dos espacios al final son un salto de línea.
[*.md]
trim_trailing_whitespace = false

# Windows necesita CRLF en sus scripts.
[*.{bat,cmd,ps1}]
end_of_line = crlf
