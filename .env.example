# ============================================================================================
#  .env — secretos del bot. NUNCA lo compartas ni lo subas a ningún sitio.
#  En modo SIMULADO y en SHADOW no hace falta rellenar nada de Hyperliquid.
# ============================================================================================

# --- Solo para el modo REAL (además hace falta "real": {"habilitado": true, ...} en config.json) ---
# Clave privada de una API WALLET (agente) creada en https://app.hyperliquid.xyz/API desde tu cuenta
# PRINCIPAL. Puede operar, NO puede retirar. Nunca pongas aquí la clave de tu wallet principal.
HL_API_WALLET_KEY=
# Dirección de la SUBCUENTA dedicada al bot (la creas tú en Hyperliquid; el bot no crea ni mueve fondos).
# Debe coincidir con "real.subcuenta" de config.json.
HL_DIRECCION_CUENTA=
# Confirmación explícita para operar con dinero real. Déjalo VACÍO salvo que hayas decidido pasar a real.
# (Con cualquier modo distinto de "real" el bot se niega a arrancar si esto vale SI.)
BOT_REAL_CONFIRMADO=

# --- Telegram (opcional) ---
# 1) @BotFather -> /newbot -> copia el token aquí
TELEGRAM_TOKEN=
# 2) escribe algo a tu bot, ejecuta "python notificaciones.py" y pega aquí el número
TELEGRAM_CHAT_ID=

# --- Panel web (opcional) ---
# Contraseña del panel. Obligatoria si el panel escucha fuera de tu equipo (panel.host distinto de 127.0.0.1).
PANEL_PASSWORD=

# --- Aviso de caída (opcional, recomendado en un servidor) ---
# URL de "ping" de un vigilante externo como https://healthchecks.io (gratis). El bot la llama cada 5 minutos;
# si deja de llegar, ese servicio te avisa por Telegram o email aunque el servidor entero se haya caído.
HEALTHCHECK_URL=

# --- CoinGlass (opcional, SOLO lectura para investigación) ---
# Clave de la API v4 de CoinGlass (de pago según el plan). Sin ella el conector queda desactivado y lo dice.
# Sus datos nunca deciden entradas, tamaños ni stops (coinglass.py). Pon la clave tú; no la compartas.
COINGLASS_API_KEY=

# --- Analista de IA con Groq (opcional, SOLO lectura) ---
# Sin clave, el analista hace su informe diario sin IA. Con ella se activa solo, sin reiniciar nada (en unos 10 minutos).
# No puede operar ni cambiar la configuración (analista_ia.py). Pon la clave tú; no la compartas.
GROQ_API_KEY=
# GROQ_MODELO=openai/gpt-oss-120b
